<Window x:Class="IT_Helpdesk.Reportss"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IT_Helpdesk"
        mc:Ignorable="d"
        Title="Reportss" Height="718" Width="1080" ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <Grid Background="#FFD1D1D1">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0*"/>
            <ColumnDefinition Width="53*"/>
            <ColumnDefinition Width="1027*"/>
        </Grid.ColumnDefinitions>
        <Rectangle HorizontalAlignment="Left" Height="669" Stroke="Black" VerticalAlignment="Top" Width="200" RenderTransformOrigin="0.5,0.5" Grid.Column="1" Margin="24,25,0,0" Grid.ColumnSpan="2" RadiusX="20" RadiusY="15" StrokeThickness="0" StrokeEndLineCap="Round" Fill="White">
            <Rectangle.Effect>
                <DropShadowEffect/>
            </Rectangle.Effect>
            <Rectangle.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform AngleY="0"/>
                    <RotateTransform/>
                    <TranslateTransform Y="0"/>
                </TransformGroup>
            </Rectangle.RenderTransform>
        </Rectangle>
        <Image Grid.Column="2" HorizontalAlignment="Left"  Height="76" Margin="34,65,0,0" VerticalAlignment="Top" Width="76" Source="/Images/logo.png" Stretch="Fill"/>
        <Label Grid.Column="2" Content="Reports" HorizontalAlignment="Left" Margin="251,37,0,0" VerticalAlignment="Top" FontSize="15"/>
        <Image Grid.Column="2" HorizontalAlignment="Left" Height="28" Margin="218,38,0,0" VerticalAlignment="Top" Width="25" Source="/Images/report.png" RenderTransformOrigin="2.808,1.772" Stretch="Fill"/>
        <Rectangle HorizontalAlignment="Left" Height="441" Stroke="Black" VerticalAlignment="Top" Width="676" RenderTransformOrigin="0.5,0.5" Grid.Column="2" Margin="281,144,0,0" RadiusX="20" RadiusY="15" StrokeThickness="0" StrokeEndLineCap="Round" Fill="White">
            <Rectangle.Effect>
                <DropShadowEffect/>
            </Rectangle.Effect>
            <Rectangle.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform AngleY="0"/>
                    <RotateTransform/>
                    <TranslateTransform Y="0"/>
                </TransformGroup>
            </Rectangle.RenderTransform>
        </Rectangle>
        <Label Grid.Column="2" Content="From : " HorizontalAlignment="Left" Margin="392,169,0,0" VerticalAlignment="Top" RenderTransformOrigin="-1.99,-1.924" FontSize="14"/>
        <DatePicker Grid.Column="2" HorizontalAlignment="Center" Margin="0,169,0,0" VerticalAlignment="Top"/>
        <Label Grid.Column="2" Content="To :" HorizontalAlignment="Left" Margin="617,169,0,0" VerticalAlignment="Top" RenderTransformOrigin="-1.99,-1.924" FontSize="14"/>
        <DatePicker Grid.Column="2" HorizontalAlignment="Left" Margin="680,169,0,0" VerticalAlignment="Top"/>
        <Label Grid.Column="2" Content="Status :" HorizontalAlignment="Left" Margin="390,246,0,0" VerticalAlignment="Top" RenderTransformOrigin="-1.99,-1.924" FontSize="14"/>
        <ComboBox Grid.Column="2" HorizontalAlignment="Left" Margin="463,248,0,0" VerticalAlignment="Top" Width="120"/>
        <DataGrid x:Name="dgTickets"
            AutoGenerateColumns="False"
            HeadersVisibility="Column"
            GridLinesVisibility="All"
            BorderBrush="Black"
            BorderThickness="1"
            CanUserAddRows="False"
            Margin="380,344,141,147" Grid.Column="2" FontSize="14" FontWeight="Bold">

            <DataGrid.Columns>

                <DataGridTextColumn Header="Status  "
                    Binding="{Binding TicketID}"
                    Width="200"/>

                <DataGridTextColumn Header="Total"
                    Binding="{Binding Title}"
                    Width="200"/>




            </DataGrid.Columns>
            <DataGrid.RowStyle>
                <Style TargetType="{x:Type DataGridRow}">
                    <Setter Property="Height" Value="30"/>
                </Style>
            </DataGrid.RowStyle>

        </DataGrid>
        <Button Content="Dashboard" HorizontalAlignment="Left" Margin="47,187,0,0" VerticalAlignment="Top" Grid.ColumnSpan="2" Width="156" Height="36" Click="Button_Click" BorderBrush="#FFB4B4B4" FontFamily="Roboto" Background="White" BorderThickness="0.5,0.5,0.5,0.5" FontSize="11" Grid.Column="1">
            <Button.Style>
                <Style/>
            </Button.Style>
        </Button>
        <Button Content="Reports" HorizontalAlignment="Left" Margin="47,391,0,0" VerticalAlignment="Top" Grid.ColumnSpan="2" Width="156" Height="36" Click="Button_Click" BorderBrush="#FFB4B4B4" FontFamily="Roboto" Background="White" BorderThickness="0.5,0.5,0.5,0.5" FontSize="11" Grid.Column="1">
            <Button.Style>
                <Style/>
            </Button.Style>
        </Button>
        <Image HorizontalAlignment="Left" Height="24" Margin="12,198,0,0" VerticalAlignment="Top" Width="15" Source="/Images/dashboard.png" RenderTransformOrigin="2.808,1.772" OpacityMask="Black" Grid.Column="2"/>
        <Image HorizontalAlignment="Left" Height="24" Margin="12,401,0,0" VerticalAlignment="Top" Width="15" Source="/Images/report.png" RenderTransformOrigin="2.808,1.772" Grid.Column="2"/>
        <Button Content="Log Out" HorizontalAlignment="Left" Margin="47,455,0,0" VerticalAlignment="Top" Grid.ColumnSpan="2" Width="156" Height="36" Click="Button_Click" BorderBrush="#FFB4B4B4" FontFamily="Roboto" Background="White" BorderThickness="0.5,0.5,0.5,0.5" FontSize="11" Grid.Column="1">
            <Button.Style>
                <Style/>
            </Button.Style>
        </Button>
        <Image HorizontalAlignment="Left" Height="24" Margin="12,465,0,0" VerticalAlignment="Top" Width="15" Source="/Images/logout.png" RenderTransformOrigin="2.808,1.772" Grid.Column="2"/>
        <Label Grid.Column="2" Content="Assigned Tickets Summary" HorizontalAlignment="Left" Margin="380,301,0,0" VerticalAlignment="Top" FontSize="15" RenderTransformOrigin="0.41,0.175" FontWeight="Bold"/>
        <Button Grid.Column="1" Content="Assigned Tickets" HorizontalAlignment="Left" Margin="47,254,0,0" VerticalAlignment="Top" Grid.ColumnSpan="2" Width="156" Height="36" Click="Button_Click" BorderBrush="#FFB4B4B4" FontFamily="Roboto" Background="{x:Null}" BorderThickness="0.5,0.5,0.5,0.5" FontSize="11"/>
        <Image Grid.Column="2" HorizontalAlignment="Left" Height="24" Margin="12,266,0,0" VerticalAlignment="Top" Width="15" Source="/Images/ticket.png" RenderTransformOrigin="2.808,1.772"/>
        <Button Grid.Column="1" Content="Update Ticekts" HorizontalAlignment="Left" Margin="47,322,0,0" VerticalAlignment="Top" Grid.ColumnSpan="2" Width="156" Height="36" Click="Button_Click" BorderBrush="#FFB4B4B4" FontFamily="Roboto" Background="White" BorderThickness="0.5,0.5,0.5,0.5" FontSize="11">
            <Button.Style>
                <Style/>
            </Button.Style>
        </Button>
        <Image Grid.Column="2" HorizontalAlignment="Left" Height="24" Margin="12,332,0,0" VerticalAlignment="Top" Width="15" Source="/Images/user.png" RenderTransformOrigin="2.808,1.772"/>
        <Button Content="Generate Report" HorizontalAlignment="Left" Margin="502,618,0,0" VerticalAlignment="Top" Width="234" Height="47" Click="Button_Click" BorderBrush="Black" FontFamily="Roboto" Background="#FF006DB5" BorderThickness="0.5,0.5,0.5,0.5" FontSize="15" Grid.Column="2" Foreground="White">
            <Button.Effect>
                <DropShadowEffect/>
            </Button.Effect>
            <Button.Style>
                <Style/>
            </Button.Style>
        </Button>

    </Grid>
</Window>

