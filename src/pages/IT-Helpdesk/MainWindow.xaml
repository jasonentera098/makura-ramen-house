<Window x:Class="IT_Helpdesk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IT_Helpdesk"
        xmlns:converters="clr-namespace:IT_Helpdesk.Converters"
        mc:Ignorable="d"
        Title="IT Helpdesk System"
        Height="677" Width="474"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#FFE8E8E8">

    <Window.Resources>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
    </Window.Resources>

    <Grid Background="#FF92C3AC" Margin="0,0,0,-6">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="17*"/>
            <ColumnDefinition Width="103*"/>
        </Grid.ColumnDefinitions>
        <!-- Centered login card -->
        <Border HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Width="380"
                Background="White"
                CornerRadius="8"
                Padding="40,36,40,36" Grid.ColumnSpan="2" Margin="34,0,0,0" Height="556">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.12" Color="#000000"/>
            </Border.Effect>

            <StackPanel>
                <!-- Logo -->
                <Image Source="/Images/logo.png"
                       Width="90" Height="90"
                       HorizontalAlignment="Center"
                       Stretch="Uniform"
                       Margin="0,0,0,12"/>

                <!-- Title -->
                <TextBlock Text="IT Helpdesk System"
                           FontFamily="Roboto"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="#FF1A1A2E"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,4"/>

                <!-- Subtitle -->
                <TextBlock Text="Please sign in to continue"
                           FontFamily="Roboto"
                           FontSize="13"
                           Foreground="#FF888888"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,28"/>

                <!-- Username label -->
                <TextBlock Text="Username"
                           FontFamily="Roboto"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#FF444444"
                           Margin="0,0,0,6"/>

                <!-- Username TextBox -->
                <TextBox x:Name="txtUsername"
                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         FontFamily="Roboto"
                         FontSize="14"
                         Height="40"
                         Padding="10,0"
                         VerticalContentAlignment="Center"
                         BorderBrush="#FFCCCCCC"
                         BorderThickness="1"
                         Margin="0,0,0,16">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Style.Triggers>
                                <Trigger Property="IsFocused" Value="True">
                                    <Setter Property="BorderBrush" Value="#FF007ACC"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>

                <!-- Password label -->
                <TextBlock Text="Password"
                           FontFamily="Roboto"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#FF444444"
                           Margin="0,0,0,6"/>

                <!-- Password field with toggle visibility -->
                <Grid Margin="0,0,0,16">
                    <PasswordBox x:Name="txtPassword"
                                 FontFamily="Roboto"
                                 FontSize="14"
                                 Height="40"
                                 Padding="10,0,40,0"
                                 VerticalContentAlignment="Center"
                                 BorderBrush="#FFCCCCCC"
                                 BorderThickness="1">
                        <PasswordBox.Style>
                            <Style TargetType="PasswordBox">
                                <Style.Triggers>
                                    <Trigger Property="IsFocused" Value="True">
                                        <Setter Property="BorderBrush" Value="#FF007ACC"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </PasswordBox.Style>
                    </PasswordBox>

                    <TextBox x:Name="txtPasswordVisible"
                             FontFamily="Roboto"
                             FontSize="14"
                             Height="40"
                             Padding="10,0,40,0"
                             VerticalContentAlignment="Center"
                             BorderBrush="#FFCCCCCC"
                             BorderThickness="1"
                             Visibility="Collapsed">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Style.Triggers>
                                    <Trigger Property="IsFocused" Value="True">
                                        <Setter Property="BorderBrush" Value="#FF007ACC"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <!-- Toggle visibility button -->
                    <Button x:Name="btnTogglePassword"
                            Width="30" Height="30"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,5,0"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="btnTogglePassword_Click"
                            ToolTip="Show/Hide Password">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="4">
                                                <ContentPresenter HorizontalAlignment="Center" 
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F0F0F0"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock x:Name="txtEyeIcon" 
                                   Text="👁" 
                                   FontSize="16"
                                   Foreground="#666666"/>
                    </Button>
                </Grid>

                <!-- Error message - visible only when ErrorMessage is non-empty -->
                <TextBlock x:Name="txtError"
                           Text="{Binding ErrorMessage}"
                           FontFamily="Roboto"
                           FontSize="12"
                           Foreground="#FFD32F2F"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10"
                           Visibility="{Binding ErrorMessage,
                               Converter={StaticResource StringToVisibilityConverter}}"/>

                <!-- LOG IN Button -->
                <Button x:Name="btnLogin"
                        Content="LOG IN"
                        Command="{Binding LoginCommand}"
                        FontFamily="Roboto"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Height="42"
                        Background="#FF007ACC"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Margin="0,0,0,10">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#FF007ACC"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="4"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#FF005FA3"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="#FF004F8A"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- EXIT Button -->

                <!-- Loading indicator -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <ProgressBar IsIndeterminate="True"
                                 Width="120" Height="6"
                                 Foreground="#FF007ACC"
                                 Margin="0,0,8,0"/>
                    <TextBlock Text="Signing in..."
                               FontFamily="Roboto"
                               FontSize="12"
                               Foreground="#FF007ACC"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <Button x:Name="btnExit"
                        Content="EXIT"
                        Click="btnExit_Click"
                        FontFamily="Roboto"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Height="42"
                        Background="#FF6C757D"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        >
                    <Button.Style>
                        <Style TargetType="{x:Type Button}">
                            <Setter Property="Background" Value="#FF6C757D"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type Button}">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="4"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#FF5A6268"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="#FF4E555B"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

            </StackPanel>
        </Border>
    </Grid>
</Window>

