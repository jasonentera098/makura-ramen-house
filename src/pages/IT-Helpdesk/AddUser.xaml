<Window x:Class="IT_Helpdesk.AddUser"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IT_Helpdesk"
        mc:Ignorable="d"
        Title="Add User"
        Height="700" Width="500"
        MinHeight="650" MinWidth="480"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        FontFamily="Roboto"
        Background="#F5F7FA">

    <Window.Resources>
        <!-- Rounded text input style -->
        <Style x:Key="FormInputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#D0D0D0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#007ACC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Rounded password input style -->
        <Style x:Key="FormPasswordStyle" TargetType="PasswordBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#D0D0D0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#007ACC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Rounded ComboBox style -->
        <Style x:Key="FormComboStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#D0D0D0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <!-- Action button style -->
        <Style x:Key="FormButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Field label style -->
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#444444"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Border Background="White"
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                CornerRadius="0"
                Margin="0"
                Padding="32,28">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="1" BlurRadius="8" Opacity="0.06"/>
            </Border.Effect>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>

                    <!-- Title with Icon -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Border Background="#E3F2FD"
                                Width="40"
                                Height="40"
                                CornerRadius="8"
                                Margin="0,0,12,0">
                            <TextBlock Text="👤"
                                       FontSize="20"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="txtTitle"
                                       Text="Add User"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="#1A1A2E"/>
                            <TextBlock Text="Create a new user account"
                                       FontSize="12"
                                       Foreground="#666666"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    
                    <!-- Divider -->
                    <Rectangle Height="1" Fill="#E0E0E0" Margin="0,0,0,20"/>

                    <!-- Full Name -->
                    <TextBlock Text="Full Name *" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox x:Name="txtFullName"
                             Style="{StaticResource FormInputStyle}"/>

                    <!-- Username -->
                    <TextBlock Text="Username *" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox x:Name="txtUsername"
                             Style="{StaticResource FormInputStyle}"
                             TextChanged="txtUsername_TextChanged"/>
                    <TextBlock x:Name="txtUsernameHint"
                               FontSize="11"
                               Foreground="#888888"
                               Margin="0,-8,0,4"
                               Text="4–30 chars, start with a letter. Letters, digits, _ and - only."
                               Visibility="Collapsed"/>
                    <TextBlock x:Name="txtUsernameError"
                               FontSize="11"
                               Foreground="#D32F2F"
                               Margin="0,-8,0,8"
                               Visibility="Collapsed"/>

                    <!-- Password -->
                    <TextBlock x:Name="lblPassword"
                               Text="Password *"
                               Style="{StaticResource FieldLabelStyle}"/>
                    <Grid Margin="0,0,0,12">
                        <PasswordBox x:Name="txtPassword"
                                     Height="36"
                                     Padding="10,0,40,0"
                                     VerticalContentAlignment="Center"
                                     FontSize="13"
                                     BorderBrush="#D0D0D0"
                                     BorderThickness="1"
                                     PasswordChanged="txtPassword_PasswordChanged">
                            <PasswordBox.Style>
                                <Style TargetType="PasswordBox">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="PasswordBox">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="4">
                                                    <ScrollViewer x:Name="PART_ContentHost"
                                                                  Margin="{TemplateBinding Padding}"
                                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsFocused" Value="True">
                                                        <Setter Property="BorderBrush" Value="#007ACC"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </PasswordBox.Style>
                        </PasswordBox>
                        
                        <TextBox x:Name="txtPasswordVisible"
                                 Height="36"
                                 Padding="10,0,40,0"
                                 VerticalContentAlignment="Center"
                                 FontSize="13"
                                 BorderBrush="#D0D0D0"
                                 BorderThickness="1"
                                 Visibility="Collapsed"
                                 TextChanged="txtPasswordVisible_TextChanged">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="TextBox">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="4">
                                                    <ScrollViewer x:Name="PART_ContentHost"
                                                                  Margin="{TemplateBinding Padding}"
                                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsFocused" Value="True">
                                                        <Setter Property="BorderBrush" Value="#007ACC"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        
                        <!-- Toggle visibility button -->
                        <Button x:Name="btnTogglePassword"
                                Width="30" Height="30"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,0,3,0"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="btnTogglePassword_Click"
                                ToolTip="Show/Hide Password">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="4">
                                                    <ContentPresenter HorizontalAlignment="Center" 
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#F0F0F0"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <TextBlock x:Name="txtPasswordEyeIcon" 
                                       Text="👁" 
                                       FontSize="14"
                                       Foreground="#666666"/>
                        </Button>
                    </Grid>
                    <!-- Password strength indicator -->
                    <Grid x:Name="pnlPasswordStrength" Margin="0,-8,0,4" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="barStrength1" Grid.Column="0" Height="4" CornerRadius="2" Margin="0,0,3,0" Background="#E0E0E0"/>
                        <Border x:Name="barStrength2" Grid.Column="1" Height="4" CornerRadius="2" Margin="0,0,3,0" Background="#E0E0E0"/>
                        <Border x:Name="barStrength3" Grid.Column="2" Height="4" CornerRadius="2" Margin="0,0,3,0" Background="#E0E0E0"/>
                        <Border x:Name="barStrength4" Grid.Column="3" Height="4" CornerRadius="2" Background="#E0E0E0"/>
                    </Grid>
                    <TextBlock x:Name="txtPasswordStrengthLabel"
                               FontSize="11"
                               Margin="0,2,0,4"
                               Visibility="Collapsed"/>
                    <TextBlock x:Name="txtPasswordHint"
                               FontSize="11"
                               Foreground="#888888"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8"
                               Text="Min 8 chars · Uppercase · Lowercase · Number · Special char (e.g. @#!$)"
                               Visibility="Collapsed"/>
                    <TextBlock x:Name="txtPasswordError"
                               FontSize="11"
                               Foreground="#D32F2F"
                               TextWrapping="Wrap"
                               Margin="0,-4,0,8"
                               Visibility="Collapsed"/>

                    <!-- Reset Password Button (Edit mode only) -->
                    <Button x:Name="btnResetPassword"
                            Content="Reset Password to Temporary"
                            Width="200"
                            Height="32"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,12"
                            Background="#FFC107"
                            Foreground="White"
                            Style="{StaticResource FormButtonStyle}"
                            Click="btnResetPassword_Click"
                            Visibility="Collapsed"/>

                    <!-- Role -->
                    <TextBlock Text="Role *" Style="{StaticResource FieldLabelStyle}"/>
                    <ComboBox x:Name="cmbRole"
                              Style="{StaticResource FormComboStyle}"
                              SelectionChanged="cmbRole_SelectionChanged">
                        <ComboBoxItem Content="Employee"/>
                        <ComboBoxItem Content="Technician"/>
                        <ComboBoxItem Content="Administrator"/>
                    </ComboBox>

                    <!-- Department (visible only for Employee role) -->
                    <TextBlock x:Name="lblDepartment"
                               Text="Department *"
                               Style="{StaticResource FieldLabelStyle}"/>
                    <ComboBox x:Name="cmbDepartment"
                              DisplayMemberPath="DepartmentName"
                              SelectedValuePath="DepartmentID"
                              Style="{StaticResource FormComboStyle}"/>

                    <!-- Contact Number -->
                    <TextBlock Text="Contact No." Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox x:Name="txtContact"
                             Style="{StaticResource FormInputStyle}"
                             MaxLength="11"
                             TextChanged="txtContact_TextChanged"/>
                    <!-- Contact validation hint -->
                    <TextBlock x:Name="txtContactError"
                               Text="Invalid input. Must start with 09 and be exactly 11 digits."
                               FontSize="11"
                               Foreground="#D32F2F"
                               Margin="0,-8,0,8"
                               Visibility="Collapsed"/>

                    <!-- Account Status (Edit mode only) -->
                    <TextBlock x:Name="lblAccountStatus"
                               Text="Account Status *"
                               Style="{StaticResource FieldLabelStyle}"
                               Visibility="Collapsed"/>
                    <ComboBox x:Name="cmbAccountStatus"
                              Style="{StaticResource FormComboStyle}"
                              Visibility="Collapsed">
                        <ComboBoxItem Content="Active"/>
                        <ComboBoxItem Content="Inactive"/>
                    </ComboBox>

                    <!-- Inline validation error message -->
                    <TextBlock x:Name="txtError"
                               FontSize="12"
                               Foreground="#D32F2F"
                               TextWrapping="Wrap"
                               Margin="0,0,0,16"
                               Visibility="Collapsed"/>

                    <!-- Divider before buttons -->
                    <Rectangle Height="1" Fill="#E0E0E0" Margin="0,16,0,20"/>
                    
                    <!-- Action Buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,0">
                        <Button x:Name="btnCancel"
                                Content="Cancel"
                                Width="110"
                                Margin="0,0,12,0"
                                Background="#6C757D"
                                Foreground="White"
                                Style="{StaticResource FormButtonStyle}"
                                Click="btnCancel_Click"/>
                        <Button x:Name="btnSave"
                                Width="110"
                                Background="#28A745"
                                Foreground="White"
                                Style="{StaticResource FormButtonStyle}"
                                Click="btnSave_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💾" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="txtSaveButtonText" Text="Save" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
