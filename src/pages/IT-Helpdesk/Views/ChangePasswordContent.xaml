<UserControl x:Class="IT_Helpdesk.Views.ChangePasswordContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:IT_Helpdesk.Views"
             xmlns:converters="clr-namespace:IT_Helpdesk.Converters"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="700"
             FontFamily="Roboto">

    <UserControl.Resources>
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>

        <!-- Form input style for PasswordBox -->
        <Style x:Key="FormPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#D0D0D0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#007ACC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Save button style -->
        <Style x:Key="SaveButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#28A745"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Field label style -->
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#444444"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="Transparent">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Border Background="White"
                    BorderBrush="#E0E0E0"
                    BorderThickness="1"
                    CornerRadius="0"
                    Padding="32,28"
                    MaxWidth="520"
                    HorizontalAlignment="Left"
                    Margin="0,0,0,20">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="1" BlurRadius="8" Opacity="0.06"/>
                </Border.Effect>

                <StackPanel>
                    <!-- Title with Icon -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Border Background="#E3F2FD"
                                Width="40"
                                Height="40"
                                CornerRadius="8"
                                Margin="0,0,12,0">
                            <TextBlock Text="🔒"
                                       FontSize="20"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Change Password"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="#1A1A2E"/>
                            <TextBlock Text="Update your account password"
                                       FontSize="12"
                                       Foreground="#666666"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Divider -->
                    <Rectangle Height="1" Fill="#E0E0E0" Margin="0,0,0,20"/>

                    <!-- Current Password -->
                    <TextBlock Text="Current Password *" Style="{StaticResource FieldLabelStyle}"/>
                    <Grid Margin="0,0,0,12">
                        <PasswordBox x:Name="txtCurrentPassword"
                                     Height="36"
                                     Padding="10,0,40,0"
                                     VerticalContentAlignment="Center"
                                     FontSize="13"
                                     BorderBrush="#D0D0D0"
                                     BorderThickness="1">
                            <PasswordBox.Style>
                                <Style TargetType="PasswordBox">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="PasswordBox">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="4">
                                                    <ScrollViewer x:Name="PART_ContentHost"
                                                                  Margin="{TemplateBinding Padding}"
                                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsFocused" Value="True">
                                                        <Setter Property="BorderBrush" Value="#007ACC"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </PasswordBox.Style>
                        </PasswordBox>
                        
                        <TextBox x:Name="txtCurrentPasswordVisible"
                                 Height="36"
                                 Padding="10,0,40,0"
                                 VerticalContentAlignment="Center"
                                 FontSize="13"
                                 BorderBrush="#D0D0D0"
                                 BorderThickness="1"
                                 Visibility="Collapsed">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="TextBox">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="4">
                                                    <ScrollViewer x:Name="PART_ContentHost"
                                                                  Margin="{TemplateBinding Padding}"
                                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsFocused" Value="True">
                                                        <Setter Property="BorderBrush" Value="#007ACC"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        
                        <Button x:Name="btnToggleCurrentPassword"
                                Width="30" Height="30"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,0,3,0"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="btnToggleCurrentPassword_Click"
                                ToolTip="Show/Hide Password">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="4">
                                                    <ContentPresenter HorizontalAlignment="Center" 
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#F0F0F0"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <TextBlock x:Name="txtCurrentEyeIcon" 
                                       Text="👁" 
                                       FontSize="14"
                                       Foreground="#666666"/>
                        </Button>
                    </Grid>

                    <!-- New Password -->
                    <TextBlock Text="New Password *" Style="{StaticResource FieldLabelStyle}"/>
                    <Grid Margin="0,0,0,12">
                        <PasswordBox x:Name="txtNewPassword"
                                     Height="36"
                                     Padding="10,0,40,0"
                                     VerticalContentAlignment="Center"
                                     FontSize="13"
                                     BorderBrush="#D0D0D0"
                                     BorderThickness="1"
                                     PasswordChanged="txtNewPassword_PasswordChanged">
                            <PasswordBox.Style>
                                <Style TargetType="PasswordBox">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="PasswordBox">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="4">
                                                    <ScrollViewer x:Name="PART_ContentHost"
                                                                  Margin="{TemplateBinding Padding}"
                                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsFocused" Value="True">
                                                        <Setter Property="BorderBrush" Value="#007ACC"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </PasswordBox.Style>
                        </PasswordBox>
                        
                        <TextBox x:Name="txtNewPasswordVisible"
                                 Height="36"
                                 Padding="10,0,40,0"
                                 VerticalContentAlignment="Center"
                                 FontSize="13"
                                 BorderBrush="#D0D0D0"
                                 BorderThickness="1"
                                 Visibility="Collapsed"
                                 TextChanged="txtNewPasswordVisible_TextChanged">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="TextBox">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="4">
                                                    <ScrollViewer x:Name="PART_ContentHost"
                                                                  Margin="{TemplateBinding Padding}"
                                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsFocused" Value="True">
                                                        <Setter Property="BorderBrush" Value="#007ACC"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        
                        <Button x:Name="btnToggleNewPassword"
                                Width="30" Height="30"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,0,3,0"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="btnToggleNewPassword_Click"
                                ToolTip="Show/Hide Password">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="4">
                                                    <ContentPresenter HorizontalAlignment="Center" 
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#F0F0F0"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <TextBlock x:Name="txtNewEyeIcon" 
                                       Text="👁" 
                                       FontSize="14"
                                       Foreground="#666666"/>
                        </Button>
                    </Grid>
                    <!-- Password strength bar -->
                    <Grid x:Name="pnlPasswordStrength" Margin="0,-8,0,2" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="barStrength1" Grid.Column="0" Height="4" CornerRadius="2" Margin="0,0,3,0" Background="#E0E0E0"/>
                        <Border x:Name="barStrength2" Grid.Column="1" Height="4" CornerRadius="2" Margin="0,0,3,0" Background="#E0E0E0"/>
                        <Border x:Name="barStrength3" Grid.Column="2" Height="4" CornerRadius="2" Margin="0,0,3,0" Background="#E0E0E0"/>
                        <Border x:Name="barStrength4" Grid.Column="3" Height="4" CornerRadius="2" Background="#E0E0E0"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,2" x:Name="pnlStrengthLabel" Visibility="Collapsed">
                        <TextBlock Text="Strength: " FontSize="11" Foreground="#888888"/>
                        <TextBlock x:Name="txtPasswordStrengthLabel" FontSize="11" FontWeight="SemiBold"/>
                    </StackPanel>
                    <TextBlock FontSize="11" Foreground="#888888" TextWrapping="Wrap" Margin="0,0,0,10"
                               Text="Min 8 chars · Uppercase · Lowercase · Number · Special char (e.g. @#!$)"/>

                    <!-- Confirm New Password -->
                    <TextBlock Text="Confirm New Password *" Style="{StaticResource FieldLabelStyle}"/>
                    <Grid Margin="0,0,0,12">
                        <PasswordBox x:Name="txtConfirmPassword"
                                     Height="36"
                                     Padding="10,0,40,0"
                                     VerticalContentAlignment="Center"
                                     FontSize="13"
                                     BorderBrush="#D0D0D0"
                                     BorderThickness="1">
                            <PasswordBox.Style>
                                <Style TargetType="PasswordBox">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="PasswordBox">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="4">
                                                    <ScrollViewer x:Name="PART_ContentHost"
                                                                  Margin="{TemplateBinding Padding}"
                                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsFocused" Value="True">
                                                        <Setter Property="BorderBrush" Value="#007ACC"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </PasswordBox.Style>
                        </PasswordBox>
                        
                        <TextBox x:Name="txtConfirmPasswordVisible"
                                 Height="36"
                                 Padding="10,0,40,0"
                                 VerticalContentAlignment="Center"
                                 FontSize="13"
                                 BorderBrush="#D0D0D0"
                                 BorderThickness="1"
                                 Visibility="Collapsed">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="TextBox">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="4">
                                                    <ScrollViewer x:Name="PART_ContentHost"
                                                                  Margin="{TemplateBinding Padding}"
                                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsFocused" Value="True">
                                                        <Setter Property="BorderBrush" Value="#007ACC"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        
                        <Button x:Name="btnToggleConfirmPassword"
                                Width="30" Height="30"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,0,3,0"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="btnToggleConfirmPassword_Click"
                                ToolTip="Show/Hide Password">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="4">
                                                    <ContentPresenter HorizontalAlignment="Center" 
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#F0F0F0"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <TextBlock x:Name="txtConfirmEyeIcon" 
                                       Text="👁" 
                                       FontSize="14"
                                       Foreground="#666666"/>
                        </Button>
                    </Grid>

                    <!-- Error Message -->
                    <TextBlock x:Name="txtError"
                               Text="{Binding ErrorMessage}"
                               FontSize="12"
                               Foreground="#D32F2F"
                               TextWrapping="Wrap"
                               Margin="0,0,0,16">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ErrorMessage}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                                <Setter Property="Visibility" Value="Visible"/>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Divider before button -->
                    <Rectangle Height="1" Fill="#E0E0E0" Margin="0,8,0,20"/>

                    <!-- Save Button -->
                    <Button x:Name="btnSave"
                            Width="170"
                            HorizontalAlignment="Left"
                            Background="#28A745"
                            Foreground="White"
                            Style="{StaticResource SaveButtonStyle}"
                            Click="btnSave_Click"
                            IsEnabled="{Binding IsSaving, Converter={StaticResource InverseBooleanConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔐" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Save Password" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
