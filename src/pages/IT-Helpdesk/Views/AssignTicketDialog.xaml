<Window x:Class="IT_Helpdesk.Views.AssignTicketDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Assign Ticket to Technician"
        Width="650" Height="700"
        MinWidth="600" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#F5F7FA"
        FontFamily="Roboto">

    <Window.Resources>
        <!-- Primary Button Style -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="24,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#28A745"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Cancel Button Style -->
        <Style x:Key="CancelButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="24,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#DC3545"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ListBox Item Style -->
        <Style x:Key="TechnicianListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                Margin="{TemplateBinding Margin}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="White"
            BorderBrush="#E0E0E0"
            BorderThickness="1"
            CornerRadius="6"
            Margin="16">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="1" BlurRadius="8" Opacity="0.06"/>
        </Border.Effect>

        <Grid Margin="32,28,32,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header with Icon -->
            <Border Grid.Row="0" 
                    Background="#F8F9FA" 
                    BorderBrush="#E0E0E0"
                    BorderThickness="0,0,0,1"
                    Padding="0,0,0,20"
                    Margin="-32,-28,-32,0">
                <StackPanel Orientation="Horizontal" Margin="32,24,32,0">
                    <Border Background="#E3F2FD"
                            Width="48"
                            Height="48"
                            CornerRadius="8"
                            Margin="0,0,16,0">
                        <TextBlock Text="👤"
                                   FontSize="24"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Assign Ticket to Technician"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="#1A1A2E"/>
                        <TextBlock Text="Select a technician based on their current workload"
                                   FontSize="13"
                                   Foreground="#666666"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Ticket Info Card -->
            <Border Grid.Row="1"
                    Background="#F8F9FA"
                    BorderBrush="#E0E0E0"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="16"
                    Margin="0,24,0,20">
                <StackPanel>
                    <TextBlock Text="Ticket Information"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#666666"
                               Margin="0,0,0,8"/>
                    <TextBlock x:Name="TicketInfoText"
                               FontSize="14"
                               Foreground="#1A1A2E"
                               TextWrapping="Wrap"
                               LineHeight="20"/>
                </StackPanel>
            </Border>

            <!-- Technician Selection Label -->
            <TextBlock Grid.Row="2"
                       Text="Available Technicians"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="#444444"
                       Margin="0,0,0,12"/>

            <!-- Technician ListBox -->
            <Border Grid.Row="3"
                    BorderBrush="#E0E0E0"
                    BorderThickness="1"
                    CornerRadius="6"
                    Background="#FAFAFA"
                    Margin="0,0,0,20">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ListBox x:Name="TechnicianListBox"
                             BorderThickness="0"
                             Background="Transparent"
                             Padding="12"
                             ItemContainerStyle="{StaticResource TechnicianListBoxItemStyle}"
                             SelectionChanged="TechnicianListBox_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="White"
                                        BorderBrush="#E0E0E0"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="16"
                                        Cursor="Hand">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                                    <Setter Property="Background" Value="#E3F2FD"/>
                                                    <Setter Property="BorderBrush" Value="#007ACC"/>
                                                    <Setter Property="BorderThickness" Value="2"/>
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="BorderBrush" Value="#007ACC"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Row 0: Name and Status Badge -->
                                        <Grid Grid.Row="0" Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding FullName}"
                                                           FontWeight="SemiBold"
                                                           FontSize="15"
                                                           Foreground="#1A1A2E"/>
                                                <TextBlock Text="{Binding Username, StringFormat='@{0}'}"
                                                           FontSize="12"
                                                           Foreground="#666666"
                                                           Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <!-- Status Badge -->
                                            <Border Grid.Column="1"
                                                    CornerRadius="4"
                                                    Padding="8,4"
                                                    VerticalAlignment="Top">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#28A745"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Busy">
                                                                <Setter Property="Background" Value="#FD7E14"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Overloaded">
                                                                <Setter Property="Background" Value="#DC3545"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="On Leave">
                                                                <Setter Property="Background" Value="#6C757D"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Status}"
                                                           Foreground="White"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"/>
                                            </Border>
                                        </Grid>

                                        <!-- Row 1: Workload Info -->
                                        <Grid Grid.Row="1" Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="Assigned Tickets:"
                                                       FontSize="12"
                                                       Foreground="#666666"
                                                       Margin="0,0,8,0"/>

                                            <TextBlock Grid.Column="2"
                                                       FontSize="12"
                                                       FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#28A745"/>
                                                        <Setter Property="Text" Value="{Binding AssignedTicketsCount}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Busy">
                                                                <Setter Property="Foreground" Value="#FD7E14"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Overloaded">
                                                                <Setter Property="Foreground" Value="#DC3545"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="On Leave">
                                                                <Setter Property="Foreground" Value="#6C757D"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>

                                        <!-- Row 2: Workload Bar -->
                                        <Grid Grid.Row="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Progress Bar Background -->
                                            <Border Grid.Column="0"
                                                    Height="8"
                                                    Background="#E0E0E0"
                                                    CornerRadius="4"
                                                    Margin="0,0,12,0">
                                                <!-- Progress Bar Fill -->
                                                <Border HorizontalAlignment="Left"
                                                        CornerRadius="4">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#28A745"/>
                                                            <Setter Property="Width" Value="{Binding WorkloadBarWidth}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="Busy">
                                                                    <Setter Property="Background" Value="#FD7E14"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Overloaded">
                                                                    <Setter Property="Background" Value="#DC3545"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="On Leave">
                                                                    <Setter Property="Background" Value="#6C757D"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>
                                            </Border>

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding WorkloadPercentage, StringFormat='{}{0}%'}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="#666666"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>
            </Border>

            <!-- Action Buttons -->
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Info Text -->
                <TextBlock Grid.Column="0"
                           x:Name="SelectionHintText"
                           Text="Please select a technician from the list above"
                           FontSize="12"
                           Foreground="#888888"
                           VerticalAlignment="Center"/>

                <!-- Buttons -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Content="Cancel"
                            Style="{StaticResource CancelButtonStyle}"
                            Width="120"
                            Margin="0,0,12,0"
                            Click="CancelButton_Click"/>
                    <Button x:Name="AssignButton"
                            Content="Assign Ticket"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Width="140"
                            IsEnabled="False"
                            Click="AssignButton_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
