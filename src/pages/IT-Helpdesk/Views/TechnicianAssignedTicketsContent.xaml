<UserControl x:Class="IT_Helpdesk.Views.TechnicianAssignedTicketsContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900"
             FontFamily="Roboto"
             Background="#F5F7FA">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- Summary Card Style -->
        <Style x:Key="SummaryCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,16,0"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="1" BlurRadius="8" Opacity="0.06"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="#666666"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="CardValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="32"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1A1A2E"/>
        </Style>

        <!-- DataGrid Style -->
        <Style x:Key="TicketsGridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#F0F0F0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#FAFAFA"/>
            <Setter Property="ColumnHeaderHeight" Value="40"/>
            <Setter Property="RowHeight" Value="44"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
        </Style>

        <Style x:Key="DataGridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F5F5F5"/>
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>

        <!-- Search TextBox Style -->
        <Style x:Key="SearchTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#D0D0D0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <!-- Filter ComboBox Style -->
        <Style x:Key="FilterComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#D0D0D0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <!-- Action Button Style -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>

            <!-- Page Header -->
            <Grid Margin="0,0,0,24">
                <Button Content="Refresh"
                        HorizontalAlignment="Right"
                        Background="#007ACC"
                        Foreground="White"
                        Style="{StaticResource ActionButtonStyle}"
                        Command="{Binding RefreshCommand}"/>
            </Grid>

            <!-- Summary Cards -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource SummaryCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Total Assigned" Style="{StaticResource CardTitleStyle}"/>
                        <TextBlock Text="{Binding TotalCount}" Style="{StaticResource CardValueStyle}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource SummaryCardStyle}">
                    <StackPanel>
                        <TextBlock Text="In Progress" Style="{StaticResource CardTitleStyle}"/>
                        <TextBlock Text="{Binding InProgressCount}" Style="{StaticResource CardValueStyle}" Foreground="#007ACC"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource SummaryCardStyle}" Margin="0">
                    <StackPanel>
                        <TextBlock Text="Resolved" Style="{StaticResource CardTitleStyle}"/>
                        <TextBlock Text="{Binding ResolvedCount}" Style="{StaticResource CardValueStyle}" Foreground="#28A745"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Loading Indicator -->
            <Grid Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                  Margin="0,16">
                <TextBlock Text="Loading tickets..."
                           FontSize="14"
                           Foreground="#666666"
                           HorizontalAlignment="Center"/>
            </Grid>

            <!-- Tickets Card -->
            <Border Background="White"
                    BorderBrush="#E0E0E0"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="20">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="1" BlurRadius="8" Opacity="0.06"/>
                </Border.Effect>
                <StackPanel>

                    <!-- Toolbar Row -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Search TextBox -->
                        <TextBox Grid.Column="0"
                                 Margin="0,0,8,0"
                                 Style="{StaticResource SearchTextBoxStyle}"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="Search by title or ticket ID...">
                            <TextBox.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </TextBox.Resources>
                        </TextBox>

                        <!-- Status Filter -->
                        <ComboBox Grid.Column="1"
                                  Margin="0,0,8,0"
                                  Style="{StaticResource FilterComboBoxStyle}"
                                  SelectedItem="{Binding SelectedStatusFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                            <sys:String xmlns:sys="clr-namespace:System;assembly=mscorlib">All</sys:String>
                            <sys:String xmlns:sys="clr-namespace:System;assembly=mscorlib">Pending</sys:String>
                            <sys:String xmlns:sys="clr-namespace:System;assembly=mscorlib">In Progress</sys:String>
                            <sys:String xmlns:sys="clr-namespace:System;assembly=mscorlib">Resolved</sys:String>
                        </ComboBox>

                        <!-- Priority Filter -->
                        <ComboBox Grid.Column="2"
                                  Margin="0,0,8,0"
                                  Style="{StaticResource FilterComboBoxStyle}"
                                  SelectedItem="{Binding SelectedPriorityFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                            <sys:String xmlns:sys="clr-namespace:System;assembly=mscorlib">All</sys:String>
                            <sys:String xmlns:sys="clr-namespace:System;assembly=mscorlib">High</sys:String>
                            <sys:String xmlns:sys="clr-namespace:System;assembly=mscorlib">Medium</sys:String>
                            <sys:String xmlns:sys="clr-namespace:System;assembly=mscorlib">Low</sys:String>
                        </ComboBox>

                        <!-- Search Button -->
                        <Button Grid.Column="3"
                                Content="Search"
                                Margin="0,0,8,0"
                                Background="#007ACC"
                                Foreground="White"
                                Style="{StaticResource ActionButtonStyle}"
                                Command="{Binding SearchCommand}"/>

                        <!-- Clear Button -->
                        <Button Grid.Column="4"
                                Content="Clear"
                                Background="#6C757D"
                                Foreground="White"
                                Style="{StaticResource ActionButtonStyle}"
                                Command="{Binding ClearSearchCommand}"/>
                    </Grid>

                    <!-- DataGrid -->
                    <DataGrid ItemsSource="{Binding AssignedTickets}"
                              SelectedItem="{Binding SelectedTicket}"
                              Style="{StaticResource TicketsGridStyle}"
                              ColumnHeaderStyle="{StaticResource DataGridHeaderStyle}">
                        <DataGrid.Columns>

                            <!-- ID Column -->
                            <DataGridTextColumn Header="ID"
                                                Binding="{Binding TicketID}"
                                                Width="60">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Padding" Value="12,0"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Foreground" Value="#555555"/>
                                        <Setter Property="FontWeight" Value="Medium"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Title Column -->
                            <DataGridTextColumn Header="Title"
                                                Binding="{Binding Title}"
                                                Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Padding" Value="12,0"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Foreground" Value="#1A1A2E"/>
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Status Column (color-coded badge) -->
                            <DataGridTemplateColumn Header="Status" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="4"
                                                Padding="8,3"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Margin="8,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#9E9E9E"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Pending">
                                                            <Setter Property="Background" Value="#9E9E9E"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="In Progress">
                                                            <Setter Property="Background" Value="#007ACC"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Resolved">
                                                            <Setter Property="Background" Value="#28A745"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Closed">
                                                            <Setter Property="Background" Value="#3D3D3D"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Status}"
                                                       Foreground="White"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Priority Column (color-coded badge) -->
                            <DataGridTemplateColumn Header="Priority" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="4"
                                                Padding="8,3"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Margin="8,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#9E9E9E"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Priority}" Value="High">
                                                            <Setter Property="Background" Value="#DC3545"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Priority}" Value="Medium">
                                                            <Setter Property="Background" Value="#FD7E14"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Priority}" Value="Low">
                                                            <Setter Property="Background" Value="#28A745"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Priority}"
                                                       Foreground="White"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Submitted By Column -->
                            <DataGridTextColumn Header="Submitted By"
                                                Binding="{Binding SubmittedByName}"
                                                Width="150">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Padding" Value="12,0"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Foreground" Value="#555555"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Empty state message -->
                    <TextBlock Text="No assigned tickets found."
                               FontSize="14"
                               Foreground="#AAAAAA"
                               HorizontalAlignment="Center"
                               Margin="0,24">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AssignedTickets.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Action Buttons Row -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Content="Update Ticket"
                                Foreground="White"
                                Command="{Binding UpdateTicketCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
                                    <Setter Property="Background" Value="#28A745"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.4"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>

                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
