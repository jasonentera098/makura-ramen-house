<Window x:Class="IT_Helpdesk.Reports"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IT_Helpdesk"
        mc:Ignorable="d"
        Title="Reports" Height="720" Width="1080">
    <Grid>
        <Rectangle HorizontalAlignment="Left" Height="669" Stroke="Black" VerticalAlignment="Top" Width="200" RenderTransformOrigin="0.5,0.5" Margin="24,26,0,0" RadiusX="20" RadiusY="15" StrokeThickness="0" StrokeEndLineCap="Round" Fill="White">
            <Rectangle.Effect>
                <DropShadowEffect/>
            </Rectangle.Effect>
            <Rectangle.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform AngleY="0"/>
                    <RotateTransform/>
                    <TranslateTransform Y="0"/>
                </TransformGroup>
            </Rectangle.RenderTransform>
        </Rectangle>
        <Button Content="Generate Reports" HorizontalAlignment="Left" Margin="545,629,0,0" VerticalAlignment="Top" Width="230" Height="36" Click="Button_Click" BorderBrush="#FFB4B4B4" FontFamily="Roboto" Background="#FF006DB5" BorderThickness="0.5,0.5,0.5,0.5" FontSize="11" Foreground="White">
            <Button.Effect>
                <DropShadowEffect/>
            </Button.Effect>
            <Button.Style>
                <Style/>
            </Button.Style>
        </Button>
        <Button Content="Tickets" HorizontalAlignment="Left" Margin="47,254,0,0" VerticalAlignment="Top" Width="156" Height="36" Click="Button_Click" BorderBrush="#FFB4B4B4" FontFamily="Roboto" Background="{x:Null}" BorderThickness="0.5,0.5,0.5,0.5" FontSize="11"/>
        <Image HorizontalAlignment="Left" Height="24" Margin="65,266,0,0" VerticalAlignment="Top" Width="15" Source="/Images/ticket.png" RenderTransformOrigin="2.808,1.772"/>
        <Button Content="Users" HorizontalAlignment="Left" Margin="47,322,0,0" VerticalAlignment="Top" Width="156" Height="36" Click="Button_Click" BorderBrush="#FFB4B4B4" FontFamily="Roboto" Background="White" BorderThickness="0.5,0.5,0.5,0.5" FontSize="11">
            <Button.Style>
                <Style/>
            </Button.Style>
        </Button>
        <Image HorizontalAlignment="Left" Height="24" Margin="65,332,0,0" VerticalAlignment="Top" Width="15" Source="/Images/user.png" RenderTransformOrigin="2.808,1.772"/>
        <Button Content="Reports" HorizontalAlignment="Left" Margin="47,388,0,0" VerticalAlignment="Top" Width="156" Height="36" Click="Button_Click" BorderBrush="#FFB4B4B4" FontFamily="Roboto" Background="White" BorderThickness="0.5,0.5,0.5,0.5" FontSize="11">
            <Button.Style>
                <Style/>
            </Button.Style>
        </Button>
        <Image HorizontalAlignment="Left" Height="24" Margin="65,398,0,0" VerticalAlignment="Top" Width="15" Source="/Images/report.png" RenderTransformOrigin="2.808,1.772"/>
        <Button Content="Log Out" HorizontalAlignment="Left" Margin="47,456,0,0" VerticalAlignment="Top" Width="156" Height="36" Click="Button_Click" BorderBrush="#FFB4B4B4" FontFamily="Roboto" Background="White" BorderThickness="0.5,0.5,0.5,0.5" FontSize="11">
            <Button.Style>
                <Style/>
            </Button.Style>
        </Button>
        <Image HorizontalAlignment="Left" Height="24" Margin="65,466,0,0" VerticalAlignment="Top" Width="15" Source="/Images/logout.png" RenderTransformOrigin="2.808,1.772"/>
        <Image HorizontalAlignment="Left"  Height="76" Margin="87,65,0,0" VerticalAlignment="Top" Width="76" Source="/Images/logo.png" Stretch="Fill"/>
        <Label Content="Reports" HorizontalAlignment="Left" Margin="302,34,0,0" VerticalAlignment="Top" FontSize="20" Width="237"/>
        <Image HorizontalAlignment="Left" Height="28" Margin="272,38,0,0" VerticalAlignment="Top" Width="25" Source="/Images/report.png" RenderTransformOrigin="2.808,1.772" Stretch="Fill"/>
        <Label Content="From:" HorizontalAlignment="Left" Margin="407,181,0,0" VerticalAlignment="Top" FontFamily="Roboto" FontSize="15"/>
        <DatePicker HorizontalAlignment="Left" Margin="475,176,0,0" VerticalAlignment="Top" Width="178" Height="40" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" RenderTransformOrigin="0.013,0.416"/>
        <Label Content="To:" HorizontalAlignment="Left" Margin="696,176,0,0" VerticalAlignment="Top" FontFamily="Roboto" FontSize="15" RenderTransformOrigin="6.4,0.923"/>
        <DatePicker HorizontalAlignment="Left" Margin="751,173,0,0" VerticalAlignment="Top" Width="177" Height="40" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
        <Label Content="Category:" HorizontalAlignment="Left" Margin="385,238,0,0" VerticalAlignment="Top" FontFamily="Roboto" FontSize="15"/>
        <ComboBox HorizontalAlignment="Left" Margin="475,238,0,0" VerticalAlignment="Top" Width="242" Height="34"/>
        <Label Content="Category:" HorizontalAlignment="Left" VerticalAlignment="Top" FontFamily="Roboto" FontSize="13"/>

        <DataGrid x:Name="dgTickets"
            AutoGenerateColumns="False"
            HeadersVisibility="Column"
            GridLinesVisibility="All"
            BorderBrush="Black"
            BorderThickness="1"
            CanUserAddRows="False"
            Margin="385,316,145,96" FontSize="15" FontWeight="Bold">

            <DataGrid.Columns>

                <DataGridTextColumn Header="Category"
                    Binding="{Binding TicketID}"
                    Width="150"/>

                <DataGridTextColumn Header="Total"
                    Binding="{Binding Title}"
                    Width="150"/>

                <DataGridTextColumn Header="Resolved "
                    Binding="{Binding Status}"
                    Width="150"/>



                <DataGridTextColumn Header="Pending
                                    "
                    Binding="{Binding AssignedTo}"
                    Width="150"/>

            </DataGrid.Columns>
            <DataGrid.RowStyle>
                <Style TargetType="{x:Type DataGridRow}">
                    <Setter Property="Height" Value="30"/>
                </Style>
            </DataGrid.RowStyle>

        </DataGrid>
        <Button Content="Dashboard" HorizontalAlignment="Left" Margin="47,187,0,0" VerticalAlignment="Top" Width="156" Height="36" Click="Button_Click" BorderBrush="#FFB4B4B4" FontFamily="Roboto" Background="White" BorderThickness="0.5,0.5,0.5,0.5" FontSize="11">
            <Button.Style>
                <Style/>
            </Button.Style>
        </Button>
        <Label Content="Status:" HorizontalAlignment="Left" Margin="685,238,0,0" VerticalAlignment="Top" FontFamily="Roboto" FontSize="15"/>
        <ComboBox HorizontalAlignment="Left" Margin="751,238,0,0" VerticalAlignment="Top" Width="177" Height="34"/>
        <Image HorizontalAlignment="Left" Height="24" Margin="65,198,0,0" VerticalAlignment="Top" Width="15" Source="/Images/dashboard.png" RenderTransformOrigin="2.808,1.772" OpacityMask="Black"/>

    </Grid>
</Window>

